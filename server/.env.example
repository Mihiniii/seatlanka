PORT=5000
# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/seatlanka
# Any long random string
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
# Minutes a seat stays held before it is released
SEAT_HOLD_MINUTES=5
# PayHere (sandbox.payhere.lk > Integrations). Leave both empty to run in demo mode with no payment.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# Set to false only with a live merchant account
PAYHERE_SANDBOX=true
# PayHere calls this from the internet, so localhost will not work: use your deployed API URL or an ngrok tunnel
PAYHERE_NOTIFY_URL=http://localhost:5000/api/payments/notify
# Password for the demo operator created by "npm run seed" (set a strong one when deploying)
SEED_OPERATOR_PASSWORD=operator123